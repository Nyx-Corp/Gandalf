{% extends gandalf_admin_layout %}

{% import '@_theme/components/breadcrumbs.html.twig' as breadcrumbs %}

{% block title %}{{ 'credential.list.title'|trans({}, 'gandalf') }}{% endblock %}

{% block breadcrumb %}
    {{ breadcrumbs.item('credential.list.title'|trans({}, 'gandalf')) }}
{% endblock %}

{% block page_icon %}<i data-lucide="key-round" class="size-6 text-primary"></i>{% endblock %}
{% block page_title %}{{ 'credential.list.title'|trans({}, 'gandalf') }}{% endblock %}

{% block page_content %}
    {% embed '@_theme/layout/list.html.twig' with { trans_default_domain: 'gandalf' } %}

        {% block create_link '' %}
        {% block export_button '' %}

        {% block name_th %}{{ 'credential.fields.name.label'|trans({}, 'gandalf') }}{% endblock %}
        {% block name_td %}
            <a href="{{ path('gandalf_credential_edit', { uuid: item.uuid }) }}" class="text-primary hover:underline font-medium">{{ item.name }}</a>
        {% endblock %}

        {% block provider_th %}{{ 'credential.fields.provider.label'|trans({}, 'gandalf') }}{% endblock %}
        {% block provider_td %}
            <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded bg-muted text-muted-foreground">
                {{ item.provider.value }}
            </span>
        {% endblock %}

        {% block show_checkboxes %}0{% endblock %}

        {% block row_actions %}
            <a href="{{ path('gandalf_credential_edit', { uuid: item.uuid }) }}"
               class="size-7 inline-flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors"
               data-tooltip="{{ 'credential.edit.title'|trans({}, 'gandalf') }}">
                <i data-lucide="pencil" class="size-4"></i>
            </a>
        {% endblock %}

        {% block empty_text %}{{ 'credential.list.empty'|trans({}, 'gandalf') }}{% endblock %}

    {% endembed %}
{% endblock %}
