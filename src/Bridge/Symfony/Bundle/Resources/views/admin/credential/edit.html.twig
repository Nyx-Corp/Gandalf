{% extends gandalf_admin_layout %}

{% import '@_theme/components/breadcrumbs.html.twig' as breadcrumbs %}

{% block title %}{{ credential.name }} — {{ 'credential.edit.title'|trans({}, 'gandalf') }}{% endblock %}

{% block breadcrumb %}
    {{ breadcrumbs.item('credential.list.title'|trans({}, 'gandalf'), 'key-round', path('gandalf_credential_list')) }}
    {{ breadcrumbs.item(credential.name, null, null, true) }}
{% endblock %}

{% block page_icon %}<i data-lucide="key-round" class="size-6"></i>{% endblock %}
{% block page_backlink %}{{ path('gandalf_credential_list') }}{% endblock %}
{% block page_backlink_text %}{{ 'credential.list.title'|trans({}, 'gandalf') }}{% endblock %}
{% block page_title %}{{ credential.name }}{% endblock %}

{% block page_content %}
    {{ form_start(form, { 'attr': { 'class': 'flex flex-col gap-6' } }) }}

        <div class="border border-zinc-200 bg-white">
            <div class="px-4 py-3 border-b border-zinc-200 flex items-center gap-3">
                <i data-lucide="key-round" class="size-5 text-primary"></i>
                <h2 class="font-medium text-zinc-700">{{ 'credential.edit.section.info'|trans({}, 'gandalf') }}</h2>
            </div>
            <div class="p-4 grid grid-cols-2 gap-4">
                {{ form_row(form.name) }}
                {{ form_row(form.provider) }}
                <div class="col-span-2">
                    {{ form_row(form.data) }}
                </div>
            </div>
        </div>

        {% if credential.expiresAt %}
            <div class="border border-zinc-200 bg-white px-4 py-3 flex items-center gap-3">
                <i data-lucide="clock" class="size-4 text-muted-foreground"></i>
                <span class="text-sm text-muted-foreground">
                    {{ 'credential.expires_at'|trans({ date: credential.expiresAt|date('d/m/Y H:i') }, 'gandalf') }}
                </span>
                {% if credential.isExpired() %}
                    <span class="text-xs bg-destructive/10 text-destructive px-1.5 py-0.5 rounded font-medium">{{ 'credential.expired'|trans({}, 'gandalf') }}</span>
                {% endif %}
            </div>
        {% endif %}

        <div class="flex items-center justify-end gap-x-4">
            <a href="{{ path('gandalf_credential_list') }}" class="inline-flex items-center cursor-pointer text-sm/6 font-semibold text-gray-900 gap-2 hover:text-gray-700">
                {{ 'admin.action.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit" class="inline-flex cursor-pointer items-center gap-2 bg-primary/10 border border-primary/30 px-4 py-2 text-sm font-semibold text-primary hover:bg-primary/20 transition-colors">
                <i data-lucide="check" class="size-4"></i>
                {{ 'admin.action.submit'|trans({}, 'admin') }}
            </button>
        </div>

    {{ form_end(form) }}
{% endblock %}
