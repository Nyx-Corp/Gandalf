{# Gandalf — Password changed confirmation email. No action URL needed. #}
{% extends gandalf_email_layout %}

{% block title %}{{ 'email.password_changed.title'|trans({}, 'gandalf') }}{% endblock %}
{% block preheader %}{{ 'email.password_changed.preheader'|trans({}, 'gandalf') }}{% endblock %}

{% block content %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding-bottom: 24px;">
                <div style="width: 64px; height: 64px; background-color: #ecfdf5; border-radius: 50%; display: inline-block; line-height: 64px; text-align: center;">
                    <span style="font-size: 28px;">&#9989;</span>
                </div>
            </td>
        </tr>
    </table>

    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; color: #18181b; text-align: center;">
        {{ 'email.password_changed.heading'|trans({}, 'gandalf') }}
    </h1>

    <p style="margin: 0 0 24px 0; color: #52525b; text-align: center;">
        {{ 'email.password_changed.intro'|trans({}, 'gandalf') }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-left: 4px solid {% block accent_color %}#960000{% endblock %}; padding: 20px;">
                <p style="margin: 0; color: #52525b;">
                    {{ 'email.password_changed.warning'|trans({}, 'gandalf') }}
                </p>
            </td>
        </tr>
    </table>
{% endblock %}

{% block footer_reason %}
    <tr>
        <td align="center" style="padding-bottom: 12px; font-size: 12px; color: #71717a;">
            {{ 'email.password_changed.reason'|trans({}, 'gandalf') }}
        </td>
    </tr>
{% endblock %}
