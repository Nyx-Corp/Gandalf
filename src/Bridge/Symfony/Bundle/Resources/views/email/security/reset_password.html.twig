{# Gandalf — Password reset email. Variables: action_url, expires_at #}
{% extends gandalf_email_layout %}

{% block title %}{{ 'email.reset_password.title'|trans({}, 'gandalf') }}{% endblock %}
{% block preheader %}{{ 'email.reset_password.preheader'|trans({}, 'gandalf') }}{% endblock %}

{% block content %}
    <h1 style="margin: 0 0 24px; font-size: 24px; font-weight: 700; color: #18181b;">
        {{ 'email.reset_password.heading'|trans({}, 'gandalf') }}
    </h1>

    <p style="margin: 0 0 16px; color: #3f3f46;">
        {{ 'email.reset_password.intro'|trans({}, 'gandalf') }}
    </p>

    <p style="margin: 0 0 24px; color: #3f3f46;">
        {{ 'email.reset_password.instruction'|trans({}, 'gandalf') }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding: 8px 0 32px;">
                <a href="{{ action_url }}" style="display: inline-block; padding: 14px 32px; background-color: {% block button_color %}#960000{% endblock %}; color: #ffffff !important; font-weight: 600; text-decoration: none; border-radius: 4px; font-size: 16px;">
                    {{ 'email.reset_password.button'|trans({}, 'gandalf') }}
                </a>
            </td>
        </tr>
    </table>

    <p style="margin: 0 0 8px; font-size: 14px; color: #71717a;">
        {{ 'email.reset_password.expires'|trans({ expires_at: expires_at|date('d/m/Y à H:i') }, 'gandalf') }}
    </p>

    <p style="margin: 0 0 8px; font-size: 14px; color: #71717a;">
        {{ 'email.reset_password.ignore'|trans({}, 'gandalf') }}
    </p>

    <hr style="border: none; border-top: 1px solid #e4e4e7; margin: 24px 0;">

    <p style="margin: 0; font-size: 13px; color: #a1a1aa;">
        {{ 'email.reset_password.fallback'|trans({}, 'gandalf') }}<br>
        <a href="{{ action_url }}" style="color: {% block link_color %}#960000{% endblock %}; word-break: break-all;">{{ action_url }}</a>
    </p>
{% endblock %}

{% block email_reason %}{{ 'email.reset_password.reason'|trans({}, 'gandalf') }}{% endblock %}
{% block unsubscribe %}{% endblock %}
