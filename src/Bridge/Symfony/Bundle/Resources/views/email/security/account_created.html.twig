{# Gandalf — Account created email. Variables: account (email), organisation (optional, name), login_url #}
{% extends gandalf_email_layout %}

{% block title %}{{ 'email.account_created.title'|trans({}, 'gandalf') }}{% endblock %}
{% block preheader %}{{ 'email.account_created.preheader'|trans({}, 'gandalf') }}{% endblock %}

{% block content %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding-bottom: 24px;">
                <div style="width: 64px; height: 64px; background-color: #fef2f2; border-radius: 50%; display: inline-block; line-height: 64px; text-align: center;">
                    <span style="font-size: 28px;">&#128075;</span>
                </div>
            </td>
        </tr>
    </table>

    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; color: #18181b; text-align: center;">
        {{ 'email.account_created.heading'|trans({}, 'gandalf') }}
    </h1>

    <p style="margin: 0 0 24px 0; color: #52525b; text-align: center;">
        {{ 'email.account_created.intro'|trans({}, 'gandalf') }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-left: 4px solid {% block accent_color %}#960000{% endblock %}; padding: 20px;">
                <p style="margin: 0 0 12px 0; font-size: 12px; font-weight: 600; color: #71717a; text-transform: uppercase; letter-spacing: 0.05em;">
                    {{ 'email.account_created.account_details'|trans({}, 'gandalf') }}
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td style="padding-right: 8px; vertical-align: top;">
                            <span style="color: {% block icon_color %}#960000{% endblock %};">&#9993;</span>
                        </td>
                        <td style="color: #3f3f46; padding-bottom: 8px;">
                            <strong>{{ 'email.account_created.email_label'|trans({}, 'gandalf') }}</strong><br>
                            <span style="color: #52525b;">{{ account.email }}</span>
                        </td>
                    </tr>
                    {% if organisation is defined and organisation %}
                    <tr>
                        <td style="padding-right: 8px; vertical-align: top;">
                            <span style="color: {{ block('icon_color') }};">&#127970;</span>
                        </td>
                        <td style="color: #3f3f46;">
                            <strong>{{ 'email.account_created.organisation_label'|trans({}, 'gandalf') }}</strong><br>
                            <span style="color: #52525b;">{{ organisation.name }}</span>
                        </td>
                    </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td align="center">
                <a href="{{ login_url }}" style="display: inline-block; padding: 12px 32px; background-color: {% block button_color %}#960000{% endblock %}; color: #ffffff; font-weight: 600; text-decoration: none; border-radius: 4px;">
                    {{ 'email.account_created.button'|trans({}, 'gandalf') }}
                </a>
            </td>
        </tr>
    </table>

    <p style="margin: 0 0 12px 0; font-size: 13px; color: #71717a; text-align: center;">
        {{ 'email.account_created.password_info'|trans({}, 'gandalf') }}
    </p>

    {% block support_contact %}
    <p style="margin: 0; font-size: 13px; color: #71717a; text-align: center;">
        {{ 'email.account_created.help'|trans({}, 'gandalf') }}
    </p>
    {% endblock %}
{% endblock %}

{% block email_reason %}{{ 'email.account_created.reason'|trans({}, 'gandalf') }}{% endblock %}
