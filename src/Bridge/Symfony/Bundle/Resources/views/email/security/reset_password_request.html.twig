{# Gandalf — Password reset request email. Variables: action_url, expires_at #}
{% extends gandalf_email_layout %}

{% block title %}{{ 'email.reset_password_request.title'|trans({}, 'gandalf') }}{% endblock %}
{% block preheader %}{{ 'email.reset_password_request.preheader'|trans({}, 'gandalf') }}{% endblock %}

{% block content %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding-bottom: 24px;">
                <div style="width: 64px; height: 64px; background-color: #fef3c7; border-radius: 50%; display: inline-block; line-height: 64px; text-align: center;">
                    <span style="font-size: 28px;">&#128274;</span>
                </div>
            </td>
        </tr>
    </table>

    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; color: #18181b; text-align: center;">
        {{ 'email.reset_password_request.heading'|trans({}, 'gandalf') }}
    </h1>

    <p style="margin: 0 0 24px 0; color: #52525b; text-align: center;">
        {{ 'email.reset_password_request.intro'|trans({}, 'gandalf') }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td align="center">
                <a href="{{ action_url }}" style="display: inline-block; padding: 12px 28px; background-color: {% block button_color %}#C45C1A{% endblock %}; color: #ffffff; font-weight: 600; text-decoration: none; border-radius: 4px;">
                    {{ 'email.reset_password_request.button'|trans({}, 'gandalf') }}
                </a>
            </td>
        </tr>
    </table>

    <p style="margin: 0; font-size: 13px; color: #71717a; text-align: center;">
        {{ 'email.reset_password_request.expires'|trans({ expires_at: expires_at|date('d/m/Y à H:i', 'Europe/Paris') }, 'gandalf') }}
    </p>
{% endblock %}

{% block footer_reason %}
    <tr>
        <td align="center" style="padding-bottom: 12px; font-size: 12px; color: #71717a;">
            {{ 'email.reset_password_request.reason'|trans({}, 'gandalf') }}
        </td>
    </tr>
{% endblock %}
