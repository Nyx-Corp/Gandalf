{# Gandalf — Admin password reset email (with details card). Variables: account (email), reset_url/login_url, token/reset_token (optional), organisation (optional) #}
{% extends gandalf_email_layout %}

{% block title %}{{ 'email.password_reset_admin.title'|trans({}, 'gandalf') }}{% endblock %}
{% block preheader %}{{ 'email.password_reset_admin.preheader'|trans({}, 'gandalf') }}{% endblock %}

{% block content %}
    {% set resetLink = reset_url|default(login_url|default(null)) %}
    {% set resetToken = token|default(reset_token|default(null)) %}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding-bottom: 24px;">
                <div style="width: 64px; height: 64px; background-color: #fef2f2; border-radius: 50%; display: inline-block; line-height: 64px; text-align: center;">
                    <span style="font-size: 28px;">&#128274;</span>
                </div>
            </td>
        </tr>
    </table>

    <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; color: #18181b; text-align: center;">
        {{ 'email.password_reset_admin.heading'|trans({}, 'gandalf') }}
    </h1>

    <p style="margin: 0 0 24px 0; color: #52525b; text-align: center;">
        {{ 'email.password_reset_admin.intro'|trans({}, 'gandalf') }}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-left: 4px solid {% block accent_color %}#960000{% endblock %}; padding: 20px;">
                <p style="margin: 0 0 12px 0; font-size: 12px; font-weight: 600; color: #71717a; text-transform: uppercase; letter-spacing: 0.05em;">
                    {{ 'email.password_reset_admin.request_details'|trans({}, 'gandalf') }}
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td style="padding-right: 8px; vertical-align: top;">
                            <span style="color: {% block icon_color %}#960000{% endblock %};">&#9993;</span>
                        </td>
                        <td style="color: #3f3f46; padding-bottom: 8px;">
                            <strong>{{ 'email.password_reset_admin.email_label'|trans({}, 'gandalf') }}</strong><br>
                            <span style="color: #52525b;">{{ account.email }}</span>
                        </td>
                    </tr>
                    {% if resetToken %}
                    <tr>
                        <td style="padding-right: 8px; vertical-align: top;">
                            <span style="color: {{ block('icon_color') }};">&#128273;</span>
                        </td>
                        <td style="color: #3f3f46; padding-bottom: 8px;">
                            <strong>{{ 'email.password_reset_admin.token_label'|trans({}, 'gandalf') }}</strong><br>
                            <span style="color: #52525b; font-family: monospace; word-break: break-all;">{{ resetToken }}</span>
                        </td>
                    </tr>
                    {% endif %}
                    {% if organisation is defined and organisation %}
                    <tr>
                        <td style="padding-right: 8px; vertical-align: top;">
                            <span style="color: {{ block('icon_color') }};">&#127970;</span>
                        </td>
                        <td style="color: #3f3f46;">
                            <strong>{{ 'email.password_reset_admin.organisation_label'|trans({}, 'gandalf') }}</strong><br>
                            <span style="color: #52525b;">{{ organisation.name }}</span>
                        </td>
                    </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    {% if resetLink %}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
        <tr>
            <td align="center">
                <a href="{{ resetLink }}" style="display: inline-block; padding: 12px 32px; background-color: {% block button_color %}#960000{% endblock %}; color: #ffffff; font-weight: 600; text-decoration: none; border-radius: 4px;">
                    {{ 'email.password_reset_admin.button'|trans({}, 'gandalf') }}
                </a>
            </td>
        </tr>
    </table>
    {% endif %}

    <p style="margin: 0 0 12px 0; font-size: 13px; color: #71717a; text-align: center;">
        {{ 'email.password_reset_admin.expiry_info'|trans({}, 'gandalf') }}
    </p>

    {% block support_contact %}
    <p style="margin: 0; font-size: 13px; color: #71717a; text-align: center;">
        {{ 'email.password_reset_admin.help'|trans({}, 'gandalf') }}
    </p>
    {% endblock %}
{% endblock %}

{% block email_reason %}{{ 'email.password_reset_admin.reason'|trans({}, 'gandalf') }}{% endblock %}
