{#
    Gandalf — Fallback email layout.

    The host project should configure gandalf.email.layout to point
    to its own branded email base template.

    Blocks:
      title       — Email subject / <title>
      preheader   — Preview text shown in email clients
      content     — Main email body
      email_reason / footer_reason — Why the user received this email
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title '' %}</title>
</head>
<body style="margin: 0; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #fafafa;">
    <div style="max-width: 600px; margin: 0 auto; background: #ffffff; padding: 32px;">
        {% block content '' %}
    </div>
    <div style="max-width: 600px; margin: 16px auto 0; text-align: center; font-size: 12px; color: #71717a;">
        {% block email_reason '' %}
        {% block footer_reason '' %}
    </div>
</body>
</html>
